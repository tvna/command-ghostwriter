| service_label | ce_service_name | budget_name | monthly_budget_usd | idle_check_cmd |
|---|---|---|---|---|
{% for r in csv_rows %}| {{ r["service_label"] }} | {{ r["ce_service_name"] }} | {{ r["budget_name"] }} | {{ r["monthly_budget_usd"] }} | {{ r["idle_check_cmd"] }} |
