| # | Name | Type | IP Address | Netmask | 用途 |
|---|------|------|------------|---------|------|
{% for h in mgmt_hosts %}| {{ loop.index }} | {{ h["name"] }} | {{ h["type"] }} | {{ h["ip_address"] }} | {% if h["type"] == "Network" %}{{ h["netmask"] }}{% else %}(Host固定 255.255.255.255){% endif %} | {{ h["description"] }} |
{% endfor %}

